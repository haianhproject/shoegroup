# ============================================================
# ShoeGroup Backend - cau hinh moi truong
# Copy file nay thanh .env roi dien gia tri THAT cua may ban.
# TUYET DOI KHONG commit file .env len Git.
# ============================================================

SPRING_PORT=5000

# ---------- SQL Server ----------
DB_USER=sa
DB_PASS=doi_mat_khau_that_o_day
# SQL Server mac dinh: dung host + port.
DB_SERVER=localhost
DB_PORT=1433
# SQL Server Express: bo DB_PORT va mo dong sau (khong cau hinh ca hai).
# DB_INSTANCE=SQLEXPRESS
DB_NAME=ShoegroupDB
# Production: DB_ENCRYPT=true va DB_TRUST_CERT=false
DB_ENCRYPT=false
DB_TRUST_CERT=true
DB_USE_UTC=false
# Spring and SQL Server use Asia/Bangkok (UTC+07) for GETDATE() columns.

# ---------- JWT ----------
# Tao khoa manh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay_bang_chuoi_ngau_nhien_dai_toi_thieu_32_ky_tu
JWT_EXPIRES_IN=7d

# Spring luon kiem tra quyen; khong co che do warn.

# ---------- Frontend / CORS ----------
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---------- Gioi han request ----------
BODY_LIMIT=5mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_LOGIN=10
RATE_LIMIT_MAX_API=600

# ---------- Email (Gmail App Password) ----------
# Khong dat mat khau that vao file mau; neu da tung lo secret, hay thu hoi ngay tren nha cung cap.
# Bat xac minh 2 buoc cho Gmail va tao App Password 16 ky tu (khong dung mat khau dang nhap Gmail).
# EMAIL_FROM_ADDRESS phai trung EMAIL_USER hoac la bi danh Send As da duoc xac minh trong Gmail.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=ShoeGroup
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

# ---------- Spring schema / tac vu ----------
# Database phai da co schema ShoeGroup; Spring ap dung migrations runtime.
SCHEMA_ENABLED=true
JOBS_ENABLED=true
JOBS_INITIAL_DELAY_MS=5000
JOBS_DELAY_MS=3600000

# ---------- Chuyển khoản tại quầy (VietQR) ----------
# POS_BANK_ID: mã BIN 6 số hoặc mã ngân hàng theo VietQR (VD: 970415 hoặc ICB).
# POS_BANK_NAME chỉ dùng để hiển thị; 3 trường ID, số TK và chủ TK là bắt buộc.
# Không điền tài khoản mẫu/giả.
POS_BANK_ID=
POS_BANK_NAME=
POS_BANK_ACCOUNT_NO=
POS_BANK_ACCOUNT_NAME=
