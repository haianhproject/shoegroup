<mxCell id="title" value="05 — Hạ tầng migration" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#000000;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="22" width="590" height="40" as="geometry"/></mxCell>
<mxCell id="note" value="Bảng kỹ thuật ghi nhận migration đã chạy, không phải chức năng nghiệp vụ.
