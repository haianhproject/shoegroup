<diagram id="technical" name="05 — Hạ tầng migration"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1162" pageHeight="324" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="title" value="05 — Hạ tầng migration — Anh / Việt" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#000000;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="22" width="979" height="40" as="geometry" /></mxCell>
<mxCell id="note" value="Bảng kỹ thuật ghi nhận migration đã chạy, không phải chức năng nghiệp vụ. Không đưa sysdiagrams và các thủ tục SSMS vào ERD nghiệp vụ. Tên tiếng Việt là chú giải; tên bảng/cột trong DB giữ nguyên." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="70" width="979" height="55" as="geometry" /></mxCell>
