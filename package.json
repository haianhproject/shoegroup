{
  "name": "shoegroup",
  "private": true,
  "version": "2.0.0",
  "description": "ShoeGroup - website ban giay (Vue 3 + Express + SQL Server)",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm --prefix backend install",
    "dev": "concurrently -n WEB,API -c cyan,green \"vite --port=3000\" \"npm --prefix backend run dev\"",
    "dev:web": "vite --port=3000",
    "dev:api": "npm --prefix backend run dev",
    "build": "vite build",
    "preview": "vite preview --port=4173"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "vue": "^3.5.35",
    "vue-router": "^4.4.5",
    "vue-select": "^4.0.0-beta.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "vite": "^6.2.3"
  }
}
