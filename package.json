{
  "name": "shoegroup-project",
  "version": "2.0.0",
  "private": true,
  "description": "ShoeGroup - Vue frontend, Spring Boot API and SQL Server",
  "scripts": {
    "setup": "npm --prefix frontend ci && npm --prefix backend/legacy-express ci",
    "dev": "node backend/scripts/dev.cjs",
    "dev:spring": "node backend/scripts/dev.cjs",
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/maven.ps1 spring-boot:run",
    "build": "npm --prefix frontend run build",
    "build:api": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/maven.ps1 package",
    "test": "npm --prefix frontend test && npm --prefix backend/legacy-express test",
    "test:spring": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/maven.ps1 test",
    "test:spring:sql": "node backend/scripts/sql-test.cjs",
    "test:spring:pos": "node backend/scripts/pos-audit.cjs",
    "audit:source": "node tools/audit-source.cjs",
    "preview": "npm --prefix frontend run preview"
  }
}
