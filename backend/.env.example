# ============================================================
# ShoeGroup Backend - cau hinh moi truong
# Copy file nay thanh .env roi dien gia tri THAT cua may ban.
# TUYET DOI KHONG commit file .env len Git.
# ============================================================

PORT=5000
NODE_ENV=development

# ---------- SQL Server ----------
DB_USER=sa
DB_PASS=doi_mat_khau_that_o_day
DB_SERVER=127.0.0.1
DB_NAME=ShoegroupDB
# Production: DB_ENCRYPT=true va DB_TRUST_CERT=false
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ---------- JWT ----------
# Tao khoa manh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay_bang_chuoi_ngau_nhien_dai_toi_thieu_32_ky_tu
JWT_EXPIRES_IN=7d

# enforce = chan that su (khuyen dung) | warn = chi ghi log canh bao khi chuyen doi
AUTH_MODE=enforce

# ---------- Frontend / CORS ----------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---------- Gioi han request ----------
BODY_LIMIT=5mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_LOGIN=10
RATE_LIMIT_MAX_API=600

# ---------- Email (Gmail App Password) ----------
# Khong dat mat khau that vao file mau; neu da tung lo secret, hay thu hoi ngay tren nha cung cap.
EMAIL_USER=
EMAIL_PASS=
